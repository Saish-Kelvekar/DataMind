# DataMind Frontend Environment Configuration Example
# Copy to .env for local development

# Base URL pointing to the FastAPI backend service
VITE_API_BASE_URL=http://localhost:8000

# Optional flag: set to 'true' to enable local dev fixture toggle in the UI (for UI design without backend)
# Set to 'false' or leave unset in production/demo
VITE_ENABLE_DEV_FIXTURES=false
